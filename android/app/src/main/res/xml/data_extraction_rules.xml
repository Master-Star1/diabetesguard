<?xml version="1.0" encoding="utf-8"?>
<!-- Gesundheitsdaten bleiben ausschließlich auf dem Gerät:
     kein Cloud-Backup, keine Übertragung bei Gerätewechsel. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
